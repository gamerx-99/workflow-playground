# =========================================================
# Thirx AI / OpenAI Compatible API Configuration
# =========================================================
THIRX_API_KEY=your_thirx_api_key_here
THIRX_BASE_URL=https://ai.thirx.com/v1
THIRX_MODEL=Qwen3.8-27B-free

# Standard OpenAI SDK compatibility (OpenAI SDK can pick these up directly)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://ai.thirx.com/v1

# =========================================================
# Supabase Configuration (Phase 7)
# =========================================================
# Core Supabase URL & Keys (Backend / SDKs)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
SUPABASE_SECRET_KEY=your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Frontend / Next.js Public Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# =========================================================
# Node.js API Server Configuration (Phase 5b Backend)
# =========================================================
API_PORT=8788
COACH_URL=http://127.0.0.1:8787/coach
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TEACHER_SIGNUP_CODE=your-secret-teacher-signup-code

# Environment & SQLite Settings
NODE_ENV=development
SEED_DEMO_USERS=1
DB_PATH=backend/workflow_lab.db

# =========================================================
# Google Cloud / Vertex AI (Fallback for Python AI Coach)
# =========================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
